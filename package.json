{
  "name": "compiledcpulanguage",
  "displayName": "CompiledCpuLanguage",
  "description": "This is an extension for the \"CCL\" language.",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "./out/extension.js",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ccl",
        "aliases": [
          "CompiledCpuLanguage",
          "CCL"
        ],
        "extensions": [
          ".CCL",
          ".ccl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ccl",
        "scopeName": "source.ccl",
        "path": "./syntaxes/CCL.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[ccl]": {
        "editor.rulers": [
          7,
          8,
          72,
          74
        ],
        "editor.insertSpaces": true,
        "editor.indentSize": 4,
        "editor.tabSize": 4
      }
    }
  },
  "devDependencies": {
    "@types/node": "^14.14.31",
    "@types/vscode": "~1.88.0",
    "typescript": "~4.1.5"
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "glob": "^10.4.2"
  },
  "keywords": [],
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/bjornBES/compiledcpulanguage.git"
  },
  "license": "MIT",
  "publisher": "BjornBES"
}
